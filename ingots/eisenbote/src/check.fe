//! Validation of the fragment directory (the Fe repository used
//! `newsfragments/validate_files.py`). towncrier silently skips files whose
//! names don't name a configured type, so CI uses this to reject them.

use ingot::buf::{push_lit, push_own_span}
use ingot::news::{News, Status}

/// Check every file of the fragment directory that isn't ignored: it must be
/// a fragment of a configured type and end with a new line. With
/// `expect_empty`, any such file is an error (used right before a release).
pub fn check(_ news: mut News, expect_empty: bool) -> Status {
    let mut i: u64 = 0
    while i < news.file_count {
        let status = check_file(mut news, i, expect_empty)
        if !status.is_ok() {
            return status
        }
        i += 1
    }
    Status::Ok
}

fn check_file(_ news: mut News, _ file: u64, _ expect_empty: bool) -> Status {
    let name = news.name(file)
    if news.is_ignored(name) {
        return Status::Ok
    }
    news.parse_name(file)
    if expect_empty || !news.is_news(file) {
        news.begin_message()
        push_lit(mut news.data, "Unexpected file: ")
        push_own_span(mut news.data, name)
        return news.end_message()
    }
    let content = news.content(file)
    if content.len == 0 || news.data.byte_at(content.end() - 1) != 10 {
        news.begin_message()
        push_lit(mut news.data, "Fragment files need to end ")
        push_lit(mut news.data, "with new line but ")
        push_own_span(mut news.data, name)
        push_lit(mut news.data, " does not.")
        return news.end_message()
    }
    Status::Ok
}
