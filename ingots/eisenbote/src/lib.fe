//! eisenbote: assembles release notes from news fragments, like towncrier.
//!
//! The executable only talks through stdin and stdout; the `eisenbote` shell
//! script feeds it the settings, the fragment directory and the changelog,
//! and writes the results back.
//!
//!     eisenbote paths                       print the fragment directory and the changelog name
//!     eisenbote draft <version> <date>      print the release notes
//!     eisenbote build <version> <date>      print the changelog with the notes inserted
//!     eisenbote list                        print the names of the consumed fragments
//!     eisenbote check                       validate the fragment directory
//!     eisenbote check-empty                 require an empty fragment directory
//!
//! An empty version means the `version` setting. Errors are printed to
//! stdout as well; a nonzero exit status says that the output is an error.

use ingot::buf::{Span, Table, push_lit, push_span, span_eq_lit}
use ingot::check::check
use ingot::news::{News, Status}
use std::io::{Read, Write, host, write_char}
use std::native::{Args, ByteBuffer}

pub fn main(argc: i32, argv: **u8) -> i32 {
    let args = Args::new(argc, argv)
    let mut news = News::new()
    let mut out = ByteBuffer::new()
    // Copy the arguments so that only `news` is borrowed from here on.
    let mut words = Table::new(2)
    let mut i: usize = 1
    while i < args.len() {
        let span = news.intern_arg(args.get(i))
        words.push(span.start)
        words.set(words.rows() - 1, 1, span.len)
        i += 1
    }
    let code = with (Read = host(), Write = host()) {
        let code = run(words, mut news, mut out)
        let mut j: u64 = 0
        while j < out.len() {
            write_char(out.byte_at(j) as i32)
            j += 1
        }
        code
    }
    words.release()
    out.release()
    news.release()
    code
}

// Commands.
const USAGE: u64 = 0
const PATHS: u64 = 1
const DRAFT: u64 = 2
const BUILD: u64 = 3
const LIST: u64 = 4
const CHECK: u64 = 5
const CHECK_EMPTY: u64 = 6

/// `words` holds the spans (start, len) of the command line arguments in `news.data`.
///
/// The steps are split into small functions: borrow checking a function that
/// both updates `news` and writes `out` many times gets slow.
fn run(_ words: Table, _ news: mut News, _ out: mut ByteBuffer) -> i32 uses (input: mut Read) {
    let command = parse_command(words, news)
    if command == USAGE {
        return usage(mut out)
    }
    let status = load(mut news)
    if !status.is_ok() {
        return fail(mut out, news, status)
    }
    execute(command, words, mut news, mut out)
}

fn parse_command(_ words: Table, _ news: News) -> u64 {
    let count = words.rows()
    if count == 0 {
        return USAGE
    }
    let name = word(words, 0)
    let mut command = USAGE
    if span_eq_lit(news.data, name, "paths") {
        command = PATHS
    } else if span_eq_lit(news.data, name, "draft") {
        command = DRAFT
    } else if span_eq_lit(news.data, name, "build") {
        command = BUILD
    } else if span_eq_lit(news.data, name, "list") {
        command = LIST
    } else if span_eq_lit(news.data, name, "check") {
        command = CHECK
    } else if span_eq_lit(news.data, name, "check-empty") {
        command = CHECK_EMPTY
    }
    let expected: u64 = if command == DRAFT || command == BUILD { 3 } else { 1 }
    if count != expected { USAGE } else { command }
}

fn load(_ news: mut News) -> Status uses (input: mut Read) {
    let status = news.read()
    if !status.is_ok() {
        return status
    }
    news.load_settings()
}

fn execute(_ command: u64, _ words: Table, _ news: mut News, _ out: mut ByteBuffer) -> i32 {
    if command == PATHS {
        return paths(news, mut out)
    }
    if command == CHECK || command == CHECK_EMPTY {
        let status = check(mut news, expect_empty: command == CHECK_EMPTY)
        return if status.is_ok() { 0 } else { fail(mut out, news, status) }
    }
    let status = news.collect()
    if !status.is_ok() {
        return fail(mut out, news, status)
    }
    if command == LIST {
        return list(news, mut out)
    }
    release_notes(command == DRAFT, words, mut news, mut out)
}

fn paths(_ news: News, _ out: mut ByteBuffer) -> i32 {
    push_span(mut out, news.data, news.directory)
    push_lit(mut out, "\n")
    push_span(mut out, news.data, news.filename)
    push_lit(mut out, "\n")
    0
}

fn list(_ news: News, _ out: mut ByteBuffer) -> i32 {
    let mut f: u64 = 0
    while f < news.file_count {
        if news.is_news(f) {
            push_span(mut out, news.data, news.name(f))
            push_lit(mut out, "\n")
        }
        f += 1
    }
    0
}

fn release_notes(_ draft: bool, _ words: Table, _ news: mut News, _ out: mut ByteBuffer) -> i32 {
    let mut version = word(words, 1)
    if version.len == 0 {
        version = news.version
    }
    if version.len == 0 {
        push_lit(mut out, "no version given and no ")
        push_lit(mut out, "`version` setting\n")
        return 1
    }
    let date = word(words, 2)
    if draft {
        news.render(mut out, version, date)
        push_lit(mut out, "\n")
        return 0
    }
    let status = news.render_changelog(mut out, version, date)
    if !status.is_ok() {
        out.clear()
        return fail(mut out, news, status)
    }
    0
}

fn word(_ words: Table, _ index: u64) -> Span {
    Span { start: words.get(index, 0), len: words.get(index, 1) }
}

fn fail(_ out: mut ByteBuffer, _ news: News, _ status: Status) -> i32 {
    match status {
        Status::MalformedInput => push_lit(mut out, "malformed input stream")
        Status::AlreadyReleased => {
            push_lit(mut out, "It seems you've already ")
            push_lit(mut out, "produced newsfiles for ")
            push_lit(mut out, "this version?")
        }
        _ => push_span(mut out, news.data, news.message)
    }
    push_lit(mut out, "\n")
    1
}

fn usage(_ out: mut ByteBuffer) -> i32 {
    push_lit(mut out, "usage: eisenbote ")
    push_lit(mut out, "(draft|build) <version> <date>")
    push_lit(mut out, " | paths | list | check | ")
    push_lit(mut out, "check-empty\n")
    2
}
